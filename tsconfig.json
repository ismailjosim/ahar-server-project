{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/app/*"],
      "@generated/*": ["./src/generated/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
